#pragma once

// ─── WiFi ────────────────────────────────────────────────────────────────────
#define WIFI_SSID      "YourWiFiSSID"
#define WIFI_PASSWORD  "YourWiFiPassword"

// ─── Local LLM server ────────────────────────────────────────────────────────
// IP address (or hostname) of your local Python resurrection-engine server
#define LOCAL_LLM_HOST "192.168.1.100"
// Port the Flask app listens on (default: 5000)
#define LOCAL_LLM_PORT "5000"

// ─── Pin definitions for LilyGo T-Embed Plus ─────────────────────────────────
// Verify against your hardware revision schematic before flashing.

// ST7789V 1.9" display (170×320, SPI)
#define PIN_TFT_MOSI    11
#define PIN_TFT_SCLK    12
#define PIN_TFT_CS      10
#define PIN_TFT_DC      13
#define PIN_TFT_RST      9
#define PIN_TFT_BL      15   // Backlight — active HIGH

// EC11 rotary encoder
#define PIN_ENCODER_A    1
#define PIN_ENCODER_B    2
#define PIN_ENCODER_BTN 21   // Push-button (active LOW, pulled up internally)

// I2S speaker (optional — used only for boot chime if uncommented in main.cpp)
#define PIN_SPEAKER     46
