name: Build Firmware

on:
  push:
    branches: [ "main" ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.x"
      - name: Install PlatformIO
        run: pip install platformio
      - name: Build
        run: pio run -e t-embed-plus
      - name: Upload artifact
        uses: actions/upload-artifact@v4
        with:
          name: t-embed-plus-firmware
          path: .pio/build/t-embed-plus/firmware.bin